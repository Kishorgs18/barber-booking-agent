# ── Email notifications (Gmail) ───────────────────────────────────────────────
# Step 1: Enable 2-Step Verification on the Gmail account you want to send FROM
# Step 2: Go to myaccount.google.com → Security → App passwords → create one for "Mail"
# Step 3: Paste the 16-character app password below (NOT your real Gmail password)
SMTP_EMAIL=yourgmail@gmail.com
SMTP_APP_PASSWORD=xxxx xxxx xxxx xxxx
OWNER_EMAIL=kishoregs200218@gmail.com   # you — gets every alert
BARBER_EMAIL=barber@example.com         # the shop owner — gets booking alerts

# ── N8N (set this after N8N is running) ───────────────────────────────────────
# Without Docker: N8N_WEBHOOK_BASE_URL=http://localhost:5678/webhook
# With Docker:    N8N_WEBHOOK_BASE_URL=http://n8n:5678/webhook
N8N_WEBHOOK_BASE_URL=http://localhost:5678/webhook
