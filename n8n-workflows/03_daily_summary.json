{
  "name": "Barber — 03 Daily Summary + Tomorrow Reminders",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 19 * * 1-6"
            }
          ]
        }
      },
      "id": "c3d4e5f6-0003-0003-0003-000000000001",
      "name": "Every Weekday at 7pm",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=http://barber-app:8000/api/stats?password={{ $vars.ADMIN_PASSWORD }}",
        "options": {}
      },
      "id": "c3d4e5f6-0003-0003-0003-000000000002",
      "name": "Get Today's Stats",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 180]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=http://barber-app:8000/api/upcoming-bookings?days_ahead=1&password={{ $vars.ADMIN_PASSWORD }}",
        "options": {}
      },
      "id": "c3d4e5f6-0003-0003-0003-000000000003",
      "name": "Get Tomorrow's Bookings",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 420]
    },
    {
      "parameters": {
        "mode": "combine",
        "combineBy": "combineAll",
        "options": {}
      },
      "id": "c3d4e5f6-0003-0003-0003-000000000004",
      "name": "Merge Stats + Tomorrow",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [680, 300]
    },
    {
      "parameters": {
        "chatId": "={{ $vars.TELEGRAM_CHAT_ID }}",
        "text": "=📊 *Daily Summary — {{ $('Get Today\\'s Stats').item.json.shop_name }}*\n📅 {{ $('Get Today\\'s Stats').item.json.date }}\n\n✂️ Bookings today: *{{ $('Get Today\\'s Stats').item.json.today_total }}*\n💰 Paid: *{{ $('Get Today\\'s Stats').item.json.today_paid }}*\n💷 Revenue: *£{{ $('Get Today\\'s Stats').item.json.today_revenue_gbp }}*\n📈 This week: *£{{ $('Get Today\\'s Stats').item.json.week_revenue_gbp }}*\n🏆 Most popular: *{{ $('Get Today\\'s Stats').item.json.most_popular_service }}*\n\n📋 *Tomorrow ({{ $('Get Tomorrow\\'s Bookings').item.json.date }}):*\n{{ $('Get Tomorrow\\'s Bookings').item.json.bookings.length }} bookings confirmed",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "c3d4e5f6-0003-0003-0003-000000000005",
      "name": "Send Daily Summary",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [900, 300],
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_WITH_YOUR_TELEGRAM_CREDENTIAL_ID",
          "name": "Telegram Bot"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "reminder-check",
              "leftValue": "={{ $('Get Tomorrow\\'s Bookings').item.json.bookings.length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "c3d4e5f6-0003-0003-0003-000000000006",
      "name": "Has Tomorrow Bookings?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [900, 500]
    },
    {
      "parameters": {
        "fieldToSplitOut": "bookings",
        "options": {}
      },
      "id": "c3d4e5f6-0003-0003-0003-000000000007",
      "name": "Split Into Individual Bookings",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [1120, 420]
    },
    {
      "parameters": {
        "chatId": "={{ $vars.TELEGRAM_CHAT_ID }}",
        "text": "=⏰ *Reminder — Appointment Tomorrow*\n\n👤 {{ $json.customer_name }}\n📱 {{ $json.customer_phone }}\n💇 {{ $json.service_name }}\n🕐 {{ $json.booking_time }}\n💷 £{{ $json.price_gbp }} (paid ✅)",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "c3d4e5f6-0003-0003-0003-000000000008",
      "name": "Send Reminder Per Booking",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [1340, 420],
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_WITH_YOUR_TELEGRAM_CREDENTIAL_ID",
          "name": "Telegram Bot"
        }
      }
    }
  ],
  "connections": {
    "Every Weekday at 7pm": {
      "main": [
        [
          {
            "node": "Get Today's Stats",
            "type": "main",
            "index": 0
          },
          {
            "node": "Get Tomorrow's Bookings",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Today's Stats": {
      "main": [
        [
          {
            "node": "Merge Stats + Tomorrow",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Tomorrow's Bookings": {
      "main": [
        [
          {
            "node": "Merge Stats + Tomorrow",
            "type": "main",
            "index": 1
          }
        ]
      ]
    },
    "Merge Stats + Tomorrow": {
      "main": [
        [
          {
            "node": "Send Daily Summary",
            "type": "main",
            "index": 0
          },
          {
            "node": "Has Tomorrow Bookings?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has Tomorrow Bookings?": {
      "main": [
        [
          {
            "node": "Split Into Individual Bookings",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Split Into Individual Bookings": {
      "main": [
        [
          {
            "node": "Send Reminder Per Booking",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
